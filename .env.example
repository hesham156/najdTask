# ── قاعدة البيانات ──
# محليًا (SQLite):
DATABASE_URL="file:./dev.db"
# أونلاين (PostgreSQL) — بعد تشغيل: npm run db:use-postgres
# DATABASE_URL="postgresql://user:pass@host:5432/najd?schema=public"

# ── الأمان ──
# مفتاح توقيع الجلسات. ولّد واحدًا عشوائيًا طويلًا عند النشر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="ضع-هنا-مفتاحًا-عشوائيًا-طويلًا"

# ── المرفقات ──
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="50"
