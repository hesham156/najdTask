# ── قاعدة البيانات ──
# على Railway: اربطها بمتغير خدمة Postgres بهذه القيمة بالضبط
#   ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://user:pass@host:5432/najd"

# للتطوير المحلي على SQLite بدل ذلك (بعد: npm run db:use-sqlite)
# DATABASE_URL="file:./dev.db"

# ── الأمان ──
# مفتاح توقيع الجلسات. ولّد واحدًا عشوائيًا طويلًا للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="ضع-هنا-مفتاحًا-عشوائيًا-طويلًا"

# كلمة مرور حساب admin عند إنشائه أول مرة فقط.
# لو تُركت فارغة سيُنشأ بكلمة "admin123" مع تحذير في السجل.
# تغييرها لاحقًا لا يؤثر — عدّل كلمة المرور من شاشة المستخدمين.
ADMIN_PASSWORD=""

# ── المرفقات ──
# على Railway: أنشئ Volume ووصّله بمسار /data ثم اضبط القيمة على /data/uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="50"

# ── إشعارات Web Push ──
# ولّد زوج مفاتيح مرة واحدة:  node scripts/generate-vapid-keys.mjs
# لو تُركت فارغة تُعطَّل الإشعارات بهدوء ولا يظهر زر الجرس أصلًا.
# تنبيه: تغيير المفاتيح لاحقًا يُبطل كل الاشتراكات ويحتاج كل مستخدم
# لإعادة التفعيل من جهازه.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── بيانات تجريبية ──
# true تُنشئ حسابات وأوردرات تجريبية (للتطوير فقط — كلمات مرورها ضعيفة)
SEED_DEMO="false"
